# ==============================================================================
# Brazil Travels - Environment Configuration (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in your project root:
#    cp .env.example .env (Linux/macOS) or Copy-Item .env.example .env (PowerShell)
# 2. Fill in the values for your Google Drive / Google Sheets setup.
# 3. In Vite, all environment variables exposed to the client MUST start with 'VITE_'.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Storage Provider Selection
# ------------------------------------------------------------------------------
# Choose how travel progress and photos should be persisted:
# - 'local'  : Stores progress in browser LocalStorage/IndexedDB (Offline & standalone)
# - 'sheets' : Serverless sync with Google Sheets & Google Drive via Google Apps Script (Recommended)
# - 'drive'  : Direct Google Drive API & Google Sheets API with OAuth 2.0
VITE_STORAGE_MODE=sheets

# ------------------------------------------------------------------------------
# 2. Recommended: Google Apps Script Web App (Serverless, Zero Complex OAuth)
# ------------------------------------------------------------------------------
# Deploy the lightweight Google Apps Script (~30 lines) inside your Google Sheet.
# See docs/GOOGLE_SHEETS_INTEGRATION.md for step-by-step setup instructions.
# Format: https://script.google.com/macros/s/AKfycbx.../exec
VITE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec

# ------------------------------------------------------------------------------
# 3. Optional: Direct Google Cloud Platform APIs (OAuth 2.0 & API Key)
# ------------------------------------------------------------------------------
# Only needed if you prefer direct client-side Google Drive API v3 / Sheets API v4
# instead of Google Apps Script:

# Google Cloud Console Browser API Key (Enable Google Drive API & Google Sheets API)
VITE_GOOGLE_API_KEY=AIzaSy...YOUR_GOOGLE_CLOUD_API_KEY

# Google Cloud OAuth 2.0 Client ID (Type: Web Application)
# Authorized JavaScript Origins: http://localhost:5173, http://raspberrypi.local
VITE_GOOGLE_CLIENT_ID=

# Target Google Drive Folder ID where commemorative travel photos will be uploaded
# (Found in the Google Drive folder URL: https://drive.google.com/drive/folders/<FOLDER_ID>)
VITE_GOOGLE_DRIVE_FOLDER_ID=

# Google Sheets Spreadsheet ID storing travel records (destinations, dates, captions)
# (Found in the Google Sheet URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
VITE_GOOGLE_SHEETS_SPREADSHEET_ID=
